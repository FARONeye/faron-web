# URL publique du site (redirections Stripe, SEO, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — clés du tableau de bord (mode test : sk_test_…)
# Sans STRIPE_SECRET_KEY, le bouton COMMANDER reste désactivé et /api/checkout répond 503.
STRIPE_SECRET_KEY=
# Secret du endpoint webhook /api/stripe/webhook (whsec_…)
STRIPE_WEBHOOK_SECRET=
